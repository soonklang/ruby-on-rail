<div class="todo-container">
  <div class="todo-header">
    <h1>📝 Todo List</h1>
    <p class="subtitle">Keep track of your daily tasks</p>
  </div>

<%= turbo_frame_tag "todo_list_container" do %>
  <div class="min-h-screen bg-[#9333ea] flex items-center justify-center p-4 antialiased font-sans">

    <!-- Main Card Container -->
    <div class="w-full max-w-2xl bg-white rounded-2xl shadow-xl overflow-hidden">

      <!-- Purple Header Segment -->
      <div class="bg-[#9333ea] p-6 text-center text-white border-b border-purple-500/20">
        <div class="flex items-center justify-center gap-2 text-2xl font-bold mb-1">
          <span>✓</span>
          <h1>Todo List</h1>
        </div>

        <p class="text-purple-200 text-sm">
          Keep track of your daily tasks
        </p>
      </div>

      <!-- Content Area -->
      <div class="p-6 space-y-6">

        <!-- Dashboard Counter Stats -->
        <div class="grid grid-cols-3 gap-4 text-center border-b border-gray-100 pb-6">

          <div>
            <div class="text-2xl font-bold text-gray-800">
              <%= @tasks.count %>
            </div>
            <div class="text-xs uppercase tracking-wider text-gray-400 font-semibold mt-1">
              Total Tasks
            </div>
          </div>

          <div>
            <div class="text-2xl font-bold text-gray-800">
              <%= @tasks.where(completed: true).count %>
            </div>
            <div class="text-xs uppercase tracking-wider text-gray-400 font-semibold mt-1">
              Completed
            </div>
          </div>

          <div>
            <div class="text-2xl font-bold text-gray-800">
              <%= @tasks.where(completed: false).count %>
            </div>
            <div class="text-xs uppercase tracking-wider text-gray-400 font-semibold mt-1">
              Pending
            </div>
          </div>

        </div>

        <!-- Inline Task Creation Form -->
        <%= form_with model: @task, class: "flex gap-2" do |form| %>

          <div class="relative flex-1">
            <%= form.text_field :title,
              placeholder: "What needs to be done?",
              class: "w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-gray-700 placeholder-gray-400 text-sm transition" %>
          </div>

          <%= form.submit "ADD TASK",
            class: "bg-[#9333ea] hover:bg-purple-700 text-white font-bold text-xs tracking-wider px-6 py-3 rounded-xl transition cursor-pointer shadow-sm shadow-purple-200 uppercase" %>

        <% end %>

        <!-- Active Tasks List -->
        <div class="space-y-3">

          <% @tasks.where(completed: false).each do |task| %>

            <!-- Each Task has its own Turbo Frame -->
            <%= turbo_frame_tag dom_id(task) do %>

              <!-- Task Item Card -->
              <div class="flex items-center justify-between p-4 bg-gray-50/50 rounded-xl border border-gray-100 hover:border-purple-100 transition group">

                <div class="flex items-start gap-3">

                  <!-- Checkbox -->
                  <div class="flex items-center h-5 mt-0.5">
                    <%= check_box_tag "task_#{task.id}",
                      task.id,
                      task.completed,
                      class: "w-4 h-4 text-purple-600 border-gray-300 rounded focus:ring-purple-500 cursor-pointer" %>
                  </div>

                  <!-- Task Information -->
                  <div>

                    <label class="text-sm font-semibold text-gray-700 cursor-pointer block">
                      <%= task.title %>
                    </label>

                    <span class="text-xs text-gray-400 flex items-center gap-1 mt-0.5">
                      Created <%= time_ago_in_words(task.created_at) %> ago
                    </span>

                  </div>

                </div>

                <!-- Task Status & Delete -->
                <div class="flex items-center gap-3">

                  <!-- Status Badge -->
                  <span class="inline-flex items-center gap-1 bg-yellow-100 text-yellow-700 text-xs font-bold px-2.5 py-1 rounded-lg uppercase tracking-wider">
                    Pending
                  </span>

                  <!-- Delete Button -->
                  <%= button_to task_path(task),
                    method: :delete,
                    class: "text-gray-400 hover:text-red-500 p-1.5 rounded-lg hover:bg-gray-100 transition",
                    data: { turbo_confirm: "Are you sure?" } do %>

                    <svg xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor">

                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />

                    </svg>

                  <% end %>

                </div>

              </div>

            <% end %>

          <% end %>

        </div>

      </div>
    </div>
  </div>
<% end %>

</div>
